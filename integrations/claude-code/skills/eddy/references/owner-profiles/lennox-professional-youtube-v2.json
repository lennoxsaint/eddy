{
  "schema_version": "eddy-quality-profile-v3",
  "id": "lennox-professional-youtube-v2",
  "display_name": "Lennox Professional YouTube V2",
  "contract_precedence": [
    "current_run_instruction",
    "supplied_project_fact_brief_and_brand",
    "lennox_editing_taste_profile",
    "hyperframes_house_style"
  ],
  "deliverables": {
    "longs": {
      "primary": 1,
      "alternate_hooks": 2,
      "identical_shared_body": true
    },
    "shorts": {
      "minimum": 3,
      "maximum": 5,
      "padding_allowed": false
    }
  },
  "viewer_leverage": {
    "hard_gated_windows_seconds": [[0, 3], [0, 30]],
    "repair_priority": ["0_to_3", "0_to_30", "body"],
    "body_quality_may_be_weakened": false,
    "frame_one_activity_by_second": 0.04,
    "money_shot_by_second": 3,
    "real_proof_by_second": 10,
    "stakes_and_route_by_second": 30
  },
  "editorial": {
    "delivered_media_retranscription_required": true,
    "waveform_energy_envelope_overrides_bad_transcript_timing": true,
    "sample_exact_splices_required": true,
    "sequence_search_parity_required": true,
    "shot_entry_latency_max_frames": 2,
    "word_edge_protection_required": true,
    "retake_survivors_allowed": 0,
    "repeated_first_words_allowed": 0,
    "false_starts_allowed": 0,
    "unintended_chatter_allowed": 0,
    "incoherent_joins_allowed": 0,
    "shared_body_for_long_variants": true,
    "protected_exception_reason_required": true
  },
  "pacing": {
    "gap_tighten_threshold_s": 0.2,
    "gap_target_s": 0.1,
    "unprotected_gap_hard_max_s": 0.28,
    "long_mute_stretches_allowed": 0,
    "protected_pause_ceiling_s": 0.8
  },
  "proof_routing": {
    "talking_head": "human_anchor",
    "screen_recording": "real_product_action_and_proof",
    "hyperframes": "concept_relationship_result_or_weak_screen_explanation",
    "real_capture_preferred": true,
    "reconstruction_allowed_when_fact_bound": true,
    "reconstruction_receipt_required": true,
    "evidence_order": [
      "raw_source",
      "supplied_asset",
      "pixel_faithful_capture",
      "fact_bound_reconstruction",
      "diagram",
      "clearly_framed_metaphor"
    ]
  },
  "layouts": {
    "semantic_reason_required": true,
    "repeat_without_proof_reason_max": 2,
    "allowed": [
      "speaker_full",
      "pip_bottom_right",
      "pip_bottom_left",
      "pip_top_right",
      "pip_top_left",
      "vertical_speaker_left",
      "vertical_speaker_right",
      "embedded_split_left",
      "embedded_split_right",
      "speaker_plus_mental_model",
      "proof_canvas",
      "speaker_top_screen_bottom"
    ]
  },
  "motion": {
    "engine": "hyperframes",
    "hero_frame_static_before_animation": true,
    "full_segment_coverage_required": true,
    "frozen_tail_allowed": false,
    "one_frame_flash_allowed": false,
    "semantic_zoom_job_required": true,
    "automated_drift_allowed": false,
    "filler_punch_ins_allowed": false,
    "cta_animation_may_repeat": false,
    "authored_callout_bias": ["icons", "diagrams", "spatial_relationships", "mental_models"],
    "text_policy": "sparse_active_confident_factual_subordinate",
    "label_reading_grade": [3, 5]
  },
  "audio": {
    "studio_sound_required": true,
    "studio_sound_lineage_policy": "verified_descript_only",
    "music": "upbeat_lofi_background",
    "shorts_music_policy": "purposeful_variation",
    "sfx": "restrained_state_change_only",
    "allowed_sources": ["local", "supplied", "bundled", "locally_generated"],
    "provenance_fields": ["ref", "provenance", "license", "cue", "purpose", "mix_db"],
    "paid_retrieval_without_current_run_approval": false,
    "missing_suitable_audio": "block"
  },
  "grade": {
    "camera": ["natural_skin", "exposure", "white_balance", "shot_consistency"],
    "screen_recording": "preserve_source_color_fidelity"
  },
  "captions": {
    "longs_default": "disabled",
    "longs_override": "project_fact_brief_only",
    "shorts_style": "progressive_karaoke",
    "prior_words": "visible",
    "active_word": "highlighted",
    "future_words": "invisible",
    "speaker_attribution": "color_plus_label",
    "speaker_colors": "design_contract_accessible_palette",
    "source_caption_collision": "suppress_eddy_captions",
    "terminal_punctuation": [".", "?", "!"],
    "delivered_timing_proof_required": true
  },
  "review": {
    "minimum_complete_watch_critique_repair_passes": 3,
    "repair_review": "repaired_intervals_and_joins_plus_full_final",
    "independent_verifier_required": true,
    "verifier_edit_authority": false,
    "continue_until_score": 100,
    "changed_strategy_required_after_failure": true,
    "external_or_technical_blocker_must_be_exact": true,
    "red_attempts": "quarantine",
    "objective_open_items_allowed": 0,
    "subjective_optional_items_allowed": true,
    "audience_performance": "NOT_RUN",
    "promotion_state": "proof_gated_candidate_awaiting_owner_taste",
    "final_authority": "owner_taste_lock",
    "owner_rejection": "reopen_same_run"
  },
  "promotion": {
    "current_run": "apply_immediately",
    "owner_profile": "passing_correction_eval_required",
    "generic_core": "cross_project_recurrence_or_explicit_owner_designation",
    "project_facts_may_promote": false
  },
  "design_defaults": {
    "background": "#0E1014",
    "foreground": "#F7F8FA",
    "accent": "#7C5CFF"
  }
}
